{
  "name": "CustomRole",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Role name"
    },
    "color": {
      "type": "string",
      "description": "Hex color for this role e.g. #ff6600"
    },
    "description": {
      "type": "string",
      "description": "What this role is for"
    }
  },
  "required": [
    "name",
    "color"
  ]
}